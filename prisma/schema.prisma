generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  password       String?   // Added for simple Credentials auth
  leetcodeUsername String? // Added for LeetCode syncing
  problems       Problem[]
  reviews        Review[]
  createdAt      DateTime  @default(now())
}

model Problem {
  id               String    @id @default(uuid())
  userId           String
  leetcodeId       Int
  title            String
  titleSlug        String
  difficulty       String
  pattern          String    // e.g., Array, Two Pointers
  
  // FSRS Core State
  state            Int       @default(0) // 0=New, 1=Learning, 2=Review, 3=Relearning
  stability        Float     @default(0)
  difficultyWeight Float     @default(0)
  elapsedDays      Int       @default(0)
  scheduledDays    Int       @default(0)
  reps             Int       @default(0)
  lapses           Int       @default(0)
  learningSteps    Int       @default(0)
  
  lastReview       DateTime?
  nextReview       DateTime?
  
  user             User      @relation(fields: [userId], references: [id])
  reviews          Review[]

  @@unique([userId, leetcodeId]) // A user can only track a specific problem once
}

model Review {
  id                  String   @id @default(uuid())
  problemId           String
  userId              String
  
  rating              Int      // 1: Again, 2: Hard, 3: Good, 4: Easy
  timeTakenMinutes    Int?
  solvedFromScratch   Boolean  @default(true)
  neededHint          Boolean  @default(false)
  rememberedPattern   Boolean  @default(true)
  bugsMistakes        Int      @default(0)
  difficultyPerceived String   @default("Medium")
  
  // FSRS state snapshot
  state               Int
  stability           Float
  difficultyWeight    Float
  
  reviewedAt          DateTime @default(now())
  
  problem             Problem  @relation(fields: [problemId], references: [id])
  user                User     @relation(fields: [userId], references: [id])
}
